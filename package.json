{
  "name": "lexicore-ai-legal-rag-platform",
  "version": "1.0.0",
  "description": "AI-Based Legal Research Assistant for Commercial Disputes using RAG & Vector DB (MERN Stack)",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm:backend\" \"npm:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm:backend\" \"npm:frontend\"",
    "backend": "node backend/src/server.js",
    "frontend": "npm.cmd --prefix frontend run dev",
    "seed": "node backend/src/seed/seedData.js",
    "install:all": "npm.cmd --prefix backend install && npm.cmd --prefix frontend install"
  },
  "keywords": [
    "mern",
    "rag",
    "vector-database",
    "legal-tech",
    "commercial-disputes",
    "arbitration",
    "artificial-intelligence"
  ],
  "author": "Rahul",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
